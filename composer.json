{
    "name": "irodevnet/llms-txt",
    "description": "Build llms.txt, llms-full.txt and AGENTS.md for your site from your own data, check them against the llms.txt proposal, and serve them with the right headers.",
    "type": "library",
    "license": "MIT",
    "keywords": ["llms.txt", "llms-full.txt", "agents.md", "ai", "llm", "geo", "ai search", "markdown"],
    "homepage": "https://github.com/irodevltd/llms-txt-php",
    "authors": [
        {
            "name": "İRODEV LTD",
            "email": "info@irodev.net",
            "homepage": "https://irodev.net"
        }
    ],
    "support": {
        "issues": "https://github.com/irodevltd/llms-txt-php/issues",
        "source": "https://github.com/irodevltd/llms-txt-php"
    },
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "Irodev\\LlmsTxt\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Irodev\\LlmsTxt\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
